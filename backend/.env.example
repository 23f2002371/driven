# Copy to .env and fill in your values. Never commit real credentials.

PROJECT_NAME=Student Club Management API
API_STR=/api

# PostgreSQL connection string (Supabase)
# Example: postgresql+psycopg://postgres:password@db.host.supabase.co:5432/postgres
DATABASE_URL=

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OAuth 2.0 - Google (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth 2.0 - GitHub (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public URLs used for OAuth redirects
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
